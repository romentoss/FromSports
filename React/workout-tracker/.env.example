# Configuración del Chatbot con IA
# Copia este archivo como .env y agrega tu API key real

# OpenAI API Key (opcional - si no se configura, usa respuestas predefinidas)
REACT_APP_OPENAI_API_KEY=tu_api_key_de_openai_aqui

